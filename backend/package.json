{
  "name": "airbnb-manager-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API local do Airbnb Manager — reservas, despesas e fechamento financeiro",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test \"tests/*.test.js\"",
    "register-condo": "node --env-file=.env scripts/register-condo.js",
    "inspect-condo": "node --env-file=.env scripts/inspect-condo-portal.js"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "node-ical": "^0.20.1",
    "playwright": "^1.61.1"
  }
}
